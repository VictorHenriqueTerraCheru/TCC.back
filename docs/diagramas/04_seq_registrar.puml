@startuml
!include _style.iuml
autonumber
actor "Cidadão" as U
participant "App React\n(navegador)" as APP
participant "API .NET" as API
participant "Nominatim\n(OSM)" as NOM
database "PostgreSQL\n+ PostGIS" as DB
U -> APP : escolhe categoria e ajusta o local
APP -> API : GET /geocodificacao/reversa?lat&lng
API -> API : consulta o cache
opt endereço fora do cache
  API -> NOM : reverse (lat, lng)
  NOM --> API : endereço
end
API --> APP : endereço aproximado
APP -> API : GET /problemas/duplicatas?categoria&lat&lng
API -> DB : mesma categoria, não resolvidos,\nST_DWithin(50 m)
DB --> API : candidatos
API --> APP : lista de candidatos
alt existe candidato e o cidadão diz "é o mesmo"
  U -> APP : "Sim, confirmar esse"
  APP -> API : PUT /problemas/{id}/votos/existencia
  API --> APP : detalhe atualizado
else nenhum candidato ou "Não, é outro"
  U -> APP : descrição (opcional) e "Enviar registro"
  APP -> API : POST /problemas
  API -> API : valida dados e obtém o endereço\n(cache da geocodificação)
  API -> DB : INSERT problema (status = Nova)
  DB --> API : id
  API --> APP : 201 Created
  APP --> U : "Registro enviado" (selo Nova)
end
@enduml
