@startuml
!include _style.iuml
hide empty methods
class User {
  name
  email
  role : Role
  createdAt
  verifiedAt
}
class VerificationRequest {
  affiliationType
  justification
  status : VerificationStatus
  rejectionReason
  createdAt
  reviewedAt
}
class Category {
  name
  type : ReportType
  icon
  active
}
class CategoryGroup {
  key
  label
  type : ReportType
  color : GroupColor
  sortOrder
}
class Issue {
  description
  location
  approximateAddress
  status : IssueStatus
  trustScore
  createdAt
  statusChangedAt
}
class Vote {
  value : VoteValue
  roleAtVote : Role
  distanceMeters
  registeredAt
}
class Incident {
  approximateArea
  radiusMeters
  areaLabel
  occurredAt
  registeredAt
}
User "1" -- "0..*" VerificationRequest : solicita
User "0..1" -- "0..*" VerificationRequest : analisa
User "1" -- "0..*" Issue : registra
User "1" -- "0..*" Incident : relata
User "1" -- "0..*" Vote : emite
Issue "1" -- "0..*" Vote : recebe
CategoryGroup "1" -- "0..*" Category
Category "1" -- "0..*" Issue
Category "1" -- "0..*" Incident
package "Enumerações" {
enum Role {
  Citizen
  VerifiedCitizen
  Administrator
}
enum ReportType {
  Issue
  Incident
}
enum GroupColor {
  Orange
  Ochre
  Brown
  Red
  Terracotta
  Blue
  Teal
  Purple
  Pink
  Gray
}
enum IssueStatus {
  New
  Active
  PossiblyResolved
  Resolved
}
enum VoteValue {
  Positive (yes)
  Negative (no)
}
enum VerificationStatus {
  Pending
  Approved
  Rejected
}
}
Vote -[hidden]down- Role
@enduml
