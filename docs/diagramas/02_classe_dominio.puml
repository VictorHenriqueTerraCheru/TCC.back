@startuml
!include _style.iuml
hide empty methods
class Usuario {
  nome
  email
  perfil : Perfil
  criadoEm
  verificadoEm
}
class SolicitacaoVerificacao {
  tipoVinculo
  justificativa
  status : StatusVerificacao
  motivoRecusa
  criadaEm
  analisadaEm
}
class Categoria {
  nome
  tipo : TipoOcorrencia
  icone
  ativa
}
class GrupoCategoria {
  chave
  rotulo
  tipo : TipoOcorrencia
  cor : CorGrupo
  ordem
}
class Problema {
  descricao
  localizacao
  enderecoAproximado
  status : StatusProblema
  confianca
  criadoEm
  statusAlteradoEm
}
class Voto {
  valor : ValorVoto
  perfilNoMomento : Perfil
  distanciaMetros
  registradoEm
}
class Incidente {
  areaAproximada
  raioMetros
  rotuloArea
  ocorridoEm
  registradoEm
}
Usuario "1" -- "0..*" SolicitacaoVerificacao : solicita
Usuario "0..1" -- "0..*" SolicitacaoVerificacao : analisa
Usuario "1" -- "0..*" Problema : registra
Usuario "1" -- "0..*" Incidente : relata
Usuario "1" -- "0..*" Voto : emite
Problema "1" -- "0..*" Voto : recebe
GrupoCategoria "1" -- "0..*" Categoria
Categoria "1" -- "0..*" Problema
Categoria "1" -- "0..*" Incidente
package "Enumerações" {
enum Perfil {
  Cidadao
  CidadaoVerificado
  Administrador
}
enum TipoOcorrencia {
  Problema
  Incidente
}
enum CorGrupo {
  Laranja
  Ocre
  Marrom
  Vermelho
  Terracota
  Azul
  VerdeAgua
  Roxo
  Rosa
  Cinza
}
enum StatusProblema {
  Nova
  Ativa
  PossivelmenteResolvida
  Resolvida
}
enum ValorVoto {
  Positivo (sim)
  Negativo (não)
}
enum StatusVerificacao {
  Pendente
  Aprovada
  Recusada
}
}
Voto -[hidden]down- Perfil
@enduml
