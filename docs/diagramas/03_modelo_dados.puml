@startuml
!include _style.iuml
hide circle
hide empty methods
skinparam linetype ortho
entity "users" as u {
  * id : uuid <<PK>>
  --
  * name : varchar(120)
  * email : varchar(256) <<UK>>
  * password_hash : text
  * role : smallint
  * created_at : timestamptz
  verified_at : timestamptz
}
entity "verification_requests" as s {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * affiliation_type : smallint
  * justification : varchar(500)
  * status : smallint
  rejection_reason : varchar(500)
  reviewed_by_id : uuid <<FK>>
  * created_at : timestamptz
  reviewed_at : timestamptz
}
entity "category_groups" as g {
  * key : varchar(30) <<PK>>
  --
  * label : varchar(40) <<UK>>
  * type : smallint
  * color : smallint
  * sort_order : integer
}
entity "categories" as c {
  * id : smallint <<PK>>
  --
  * name : varchar(60)
  * group : varchar(30) <<FK>>
  * type : smallint
  * icon : varchar(40)
  * active : boolean
}
entity "issues" as p {
  * id : uuid <<PK>>
  --
  * category_id : smallint <<FK>>
  * author_id : uuid <<FK>>
  description : varchar(280)
  * location : geography(Point,4326)
  * approximate_address : varchar(200)
  * status : smallint
  trust_score : numeric(5,2)
  * created_at : timestamptz
  * status_changed_at : timestamptz
  resolution_condition_since : timestamptz
}
entity "votes" as v {
  * id : uuid <<PK>>
  --
  * issue_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  * value : smallint
  * role_at_vote : smallint
  distance_meters : integer
  * registered_at : timestamptz
  ..
  UK (issue_id, user_id)
}
entity "incidents" as i {
  * id : uuid <<PK>>
  --
  * category_id : smallint <<FK>>
  * author_id : uuid <<FK>>
  * approximate_area : geography(Point,4326)
  * radius_meters : smallint
  area_label : varchar(120)
  * occurred_at : timestamptz
  * registered_at : timestamptz
}
u ||--o{ s
u ||--o{ p
u ||--o{ i
u ||--o{ v
p ||--o{ v
g ||--o{ c
c ||--o{ p
c ||--o{ i
@enduml
