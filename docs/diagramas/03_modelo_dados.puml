@startuml
!include _style.iuml
hide circle
hide empty methods
skinparam linetype ortho
entity "usuarios" as u {
  * id : uuid <<PK>>
  --
  * nome : varchar(120)
  * email : varchar(256) <<UK>>
  * senha_hash : text
  * perfil : smallint
  * criado_em : timestamptz
  verificado_em : timestamptz
}
entity "solicitacoes_verificacao" as s {
  * id : uuid <<PK>>
  --
  * usuario_id : uuid <<FK>>
  * tipo_vinculo : smallint
  * justificativa : varchar(500)
  * status : smallint
  motivo_recusa : varchar(500)
  analisada_por_id : uuid <<FK>>
  * criada_em : timestamptz
  analisada_em : timestamptz
}
entity "categorias" as c {
  * id : smallint <<PK>>
  --
  * nome : varchar(60)
  * grupo : varchar(30)
  * tipo : smallint
  * icone : varchar(40)
  * ativa : boolean
}
entity "problemas" as p {
  * id : uuid <<PK>>
  --
  * categoria_id : smallint <<FK>>
  * autor_id : uuid <<FK>>
  descricao : varchar(280)
  * localizacao : geography(Point,4326)
  * endereco_aproximado : varchar(200)
  * status : smallint
  confianca : numeric(5,2)
  * criado_em : timestamptz
  * status_alterado_em : timestamptz
  condicao_resolucao_desde : timestamptz
}
entity "votos" as v {
  * id : uuid <<PK>>
  --
  * problema_id : uuid <<FK>>
  * usuario_id : uuid <<FK>>
  * valor : smallint
  * perfil_no_momento : smallint
  distancia_metros : integer
  * registrado_em : timestamptz
  ..
  UK (problema_id, usuario_id)
}
entity "incidentes" as i {
  * id : uuid <<PK>>
  --
  * categoria_id : smallint <<FK>>
  * autor_id : uuid <<FK>>
  * area_aproximada : geography(Point,4326)
  * raio_metros : smallint
  rotulo_area : varchar(120)
  * ocorrido_em : timestamptz
  * registrado_em : timestamptz
}
u ||--o{ s
u ||--o{ p
u ||--o{ i
u ||--o{ v
p ||--o{ v
c ||--o{ p
c ||--o{ i
@enduml
