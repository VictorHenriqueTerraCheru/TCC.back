@startuml
!include _style.iuml
node "Navegador (celular ou computador)" {
  component "App React\n(SPA, TypeScript)" as APP
  component "Geolocation API\ndo navegador" as GPS
}
node "Hospedagem estática (HTTPS)" as HOST
cloud "OpenStreetMap" {
  component "Servidor de tiles" as OSM
  component "Nominatim\n(geocodificação)" as NOM
}
node "Railway" {
  node "Servidor da API (container)" {
    component "API .NET 10\n(Minimal API, fatias verticais)" as API
    component "Motor de confiança\n(Feature/Trust/Engine)" as DOM
    component "Job de ciclo de vida\n(BackgroundService)" as JOB
  }
  database "PostgreSQL + PostGIS" as DB
}
node "Estação de avaliação" {
  component "Simulator\n(console .NET)" as SIM
}
HOST ..> APP : entrega os arquivos
APP --> GPS
APP --> OSM : tiles do mapa
APP --> API : HTTPS / JSON + JWT
API --> NOM : geocodificação reversa\n(cache, 1 req/s)
API --> DOM
JOB --> DOM
API --> DB : EF Core + Npgsql\n(NetTopologySuite)
JOB --> DB
SIM --> DOM : mesmas funções\n(referencia a API)
@enduml
